 },
 {
  "file": "voix/lignes/toejam_biome-le-desert_1.mp3",
  "who": "toejam",
  "text": "Il fait tarpin chaud !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-le-desert_1.mp3",
  "who": "earl",
  "text": "Du sable... Et dégun.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-la-foret-d-automne_1.mp3",
