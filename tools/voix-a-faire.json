[
 {
  "file": "voix/lignes/toejam_secret_1.mp3",
  "who": "toejam",
  "text": "Wesh... Un jacuzzi et des meufs ?! Wollah on est au paradis !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_secret_2.mp3",
  "who": "toejam",
  "text": "Téma le sang ! Ici ça sent la monoï et les bonnes affaires !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_secret_1.mp3",
  "who": "earl",
  "text": "Un jacuzzi... Des danseuses... J'suis mort et j'ai été gentil.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_secret_2.mp3",
  "who": "earl",
  "text": "Bon. Moi je bouge plus d'ici.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_drague_1.mp3",
  "who": "toejam",
  "text": "Ton père c'est un voleur ! Il a pris les deux plus belles étoiles du ciel et il en a fait tes yeux !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_2.mp3",
  "who": "toejam",
  "text": "Wesh la frappe ! T'as un 06 ou je dois le deviner ?",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_3.mp3",
  "who": "toejam",
  "text": "[laughs] T'es pas fatiguée ? T'as couru dans ma tête toute la nuit, wollah !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_4.mp3",
  "who": "toejam",
  "text": "T'aurais pas un plan ? Je me suis perdu dans tes yeux, ma reine.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_5.mp3",
  "who": "toejam",
  "text": "Téma : j'ai un vaisseau. Bon, il est en dix morceaux. Mais j'ai un vaisseau.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_6.mp3",
  "who": "toejam",
  "text": "J'ai trois jambes, ma belle. Pour toi, je me mets à genoux. Les trois.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_7.mp3",
  "who": "toejam",
  "text": "Même la bonne mère, quand elle t'a vue, elle s'est retournée.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_8.mp3",
  "who": "toejam",
  "text": "T'es plus belle que le vélodrome un soir de clasico, wollah ses grands morts.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_9.mp3",
  "who": "toejam",
  "text": "T'es tellement fraîche que le jacuzzi, il a pris froid.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_10.mp3",
  "who": "toejam",
  "text": "Je suis pas photographe, mais nous deux, je nous vois bien en story.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_11.mp3",
  "who": "toejam",
  "text": "Ma mère elle veut une belle-fille terrienne. T'es libre dimanche ?",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_drague_12.mp3",
  "who": "toejam",
  "text": "T'es la huitième merveille du monde. Les sept autres, c'est des baltringues.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_drague_1.mp3",
  "who": "earl",
  "text": "[sighs] T'es tellement belle... J'ai enlevé mes lunettes. ... Nan, je les remets.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_2.mp3",
  "who": "earl",
  "text": "[sighs] Tu crois au coup de foudre... Ou je repasse ? ... Je repasse pas. Flemme.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_3.mp3",
  "who": "earl",
  "text": "Moi c'est Earl. ... Voilà. C'était la drague.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_4.mp3",
  "who": "earl",
  "text": "Si la beauté c'était un crime, tu prends perpète. Et moi je viens au parloir. Le jeudi.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_5.mp3",
  "who": "earl",
  "text": "[sighs] T'es un aimant ? ... J'arrive plus à bouger. ... Enfin, comme d'hab.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_6.mp3",
  "who": "earl",
  "text": "Je suis pas gros, ma belle. Je suis dispo en grand format.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_7.mp3",
  "who": "earl",
  "text": "[sighs] T'aurais pas une chips ? ... Nan ? ... T'es jolie quand même.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_8.mp3",
  "who": "earl",
  "text": "On s'est pas déjà vus ? ... Dans mes rêves. ... Ou à lidl.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_9.mp3",
  "who": "earl",
  "text": "Ton père il est boulanger ? ... Parce que j'ai la dalle.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_10.mp3",
  "who": "earl",
  "text": "Le jacuzzi et moi, on a un point commun : on bouillonne. ... Lentement.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_11.mp3",
  "who": "earl",
  "text": "Je t'offrirais bien un verre... Mais j'ai que des tomates.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_drague_12.mp3",
  "who": "earl",
  "text": "T'as de beaux yeux, tu sais. ... Et un jacuzzi. Surtout un jacuzzi.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_relance_1.mp3",
  "who": "toejam",
  "text": "Elle m'a calculé, t'as vu ?! Elle m'a calculé !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_relance_2.mp3",
  "who": "toejam",
  "text": "C'est un oui, ça. En hawaïen.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_relance_3.mp3",
  "who": "toejam",
  "text": "Elle joue la difficile. Je connais le game.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_relance_4.mp3",
  "who": "toejam",
  "text": "Vas-y, c'est ta perte, la miss !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_relance_1.mp3",
  "who": "earl",
  "text": "Elle est timide.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_relance_2.mp3",
  "who": "earl",
  "text": "Je lui laisse du temps. Genre dix ans.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_relance_3.mp3",
  "who": "earl",
  "text": "C'est pas grave. J'ai le jacuzzi.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_relance_4.mp3",
  "who": "earl",
  "text": "On se comprend, elle et moi. Je crois.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_oui_1.mp3",
  "who": "toejam",
  "text": "Elle a dit oui ?! ... Attends, je sais plus marcher !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_oui_1.mp3",
  "who": "earl",
  "text": "[sighs] Oh. ... Ça, je l'avais pas prévu.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_piece_1.mp3",
  "who": "earl",
  "text": "Le vaisseau se recolle... Tranquille.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_chase-boogey_1.mp3",
  "who": "toejam",
  "text": "J'ai pas peur... J'ai pas peur... J'ai peur !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_chase-mower_1.mp3",
  "who": "toejam",
  "text": "[shouting] La tondeuse ! Cours, baltringue !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_chase-cart_1.mp3",
  "who": "toejam",
  "text": "Téma la dame au caddie, elle est fada !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_chase-mole_1.mp3",
  "who": "toejam",
  "text": "[laughs] Touche pas à mes cadeaux, la taupe !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_chase-chickens_1.mp3",
  "who": "toejam",
  "text": "Des poulets armés ! C'est la hess !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_chase-chickens_1.mp3",
  "who": "earl",
  "text": "[sighs] Des poulets qui tirent... Normal.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_chase-any_1.mp3",
  "who": "toejam",
  "text": "Et tu vas faire quoi, baltringue ?",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/toejam_chase-any_2.mp3",
  "who": "toejam",
  "text": "Oh nan...",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_chase-any_1.mp3",
  "who": "earl",
  "text": "Qu'est-ce tu me veux, toi ?",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_chase-any_2.mp3",
  "who": "earl",
  "text": "[sighs] Encore un...",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-la-prairie_1.mp3",
  "who": "toejam",
  "text": "De l'herbe ! ... C'est pas la bonne.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-la-prairie_1.mp3",
  "who": "earl",
  "text": "De l'herbe... Pas la bonne.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-la-banlieue_1.mp3",
  "who": "toejam",
  "text": "Téma les pavillons. La hess de luxe.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-la-banlieue_1.mp3",
  "who": "earl",
  "text": "La banlieue... Ça dort, ici.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-le-desert_1.mp3",
  "who": "toejam",
  "text": "Il fait tarpin chaud !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-le-desert_1.mp3",
  "who": "earl",
  "text": "Du sable... Et dégun.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-la-foret-d-automne_1.mp3",
  "who": "toejam",
  "text": "Ça sent la châtaigne, ici.",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-la-foret-d-automne_1.mp3",
  "who": "earl",
  "text": "[sighs] Les feuilles tombent... Comme moi.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-la-banquise_1.mp3",
  "who": "toejam",
  "text": "[laughs] Ça caille, le sang !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-la-banquise_1.mp3",
  "who": "earl",
  "text": "J'sens plus mes pieds. Tant mieux.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/toejam_biome-le-marais_1.mp3",
  "who": "toejam",
  "text": "Ça pue la mort, ici !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/lignes/earl_biome-le-marais_1.mp3",
  "who": "earl",
  "text": "[sighs] Ça clapote... Ça pue... Ça va.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_biome-le-pays-des-bonbons_1.mp3",
  "who": "earl",
  "text": "[sighs] Du sucre partout... Je vais mourir heureux.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_biome-la-foret-des-champignons_1.mp3",
  "who": "earl",
  "text": "Des champignons... Je touche à rien. Promis.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_biome-la-lune_1.mp3",
  "who": "earl",
  "text": "La lune... On est bien, là.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/lignes/earl_biome-le-volcan_1.mp3",
  "who": "earl",
  "text": "[sighs] Ça fume... Comme moi.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/earl_piege_1.mp3",
  "who": "earl",
  "text": "Ah. Un piège.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/earl_piege_2.mp3",
  "who": "earl",
  "text": "Évidemment...",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/tj_cine1.mp3",
  "who": "toejam",
  "text": "Wesh Earl, t'as le permis pour ce truc ?",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/earl_cine1.mp3",
  "who": "earl",
  "text": "[laughs softly] Le permis... Téma : sans les mains.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/tj_cine2.mp3",
  "who": "toejam",
  "text": "[shouting] Earl... Earl ! Le caillou, baltringue !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/earl_cine2.mp3",
  "who": "earl",
  "text": "... Oups.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/tj_cine3.mp3",
  "who": "toejam",
  "text": "Wollah, faut retrouver les dix morceaux !",
  "voice": "8R6pzcy1HIr4WcoApmzw"
 },
 {
  "file": "voix/earl_cine3.mp3",
  "who": "earl",
  "text": "Bienvenue sur Terre, le sang.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 },
 {
  "file": "voix/earl_cine4.mp3",
  "who": "earl",
  "text": "[sighs] Vas-y, toi. Moi... je fais la sieste.",
  "voice": "MCUGZje4J3p8LqPNd1k1"
 }
]
